<script>\
// =============================================================\
//  JEOPARDY PRO \'97 Single-file custom Jeopardy game builder\
// =============================================================\
\
// ---------- AUDIO ENGINE (Web Audio API generated) ----------\
const AudioEngine = (() => \{\
  let ctx = null;\
  let masterGain = null;\
  let musicGain = null;\
  let sfxGain = null;\
  let musicTimer = null;\
  let musicPlaying = false;\
  let musicEnabled = false;\
  let sfxEnabled = true;\
\
  function ensureCtx() \{\
    if (!ctx) \{\
      ctx = new (window.AudioContext || window.webkitAudioContext)();\
      masterGain = ctx.createGain();\
      masterGain.gain.value = 0.7;\
      masterGain.connect(ctx.destination);\
      musicGain = ctx.createGain();\
      musicGain.gain.value = 0.12;\
      musicGain.connect(masterGain);\
      sfxGain = ctx.createGain();\
      sfxGain.gain.value = 0.4;\
      sfxGain.connect(masterGain);\
    \}\
    if (ctx.state === 'suspended') ctx.resume();\
  \}\
\
  function playTone(freq, dur, type='sine', vol=0.3, dest=null) \{\
    if (!sfxEnabled) return;\
    ensureCtx();\
    const osc = ctx.createOscillator();\
    const gain = ctx.createGain();\
    osc.type = type;\
    osc.frequency.setValueAtTime(freq, ctx.currentTime);\
    gain.gain.setValueAtTime(0, ctx.currentTime);\
    gain.gain.linearRampToValueAtTime(vol, ctx.currentTime + 0.01);\
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);\
    osc.connect(gain).connect(dest || sfxGain);\
    osc.start();\
    osc.stop(ctx.currentTime + dur + 0.05);\
  \}\
\
  function playClick() \{\
    playTone(800, 0.05, 'square', 0.15);\
  \}\
\
  function playReveal() \{\
    if (!sfxEnabled) return;\
    ensureCtx();\
    // Sweep up\
    const osc = ctx.createOscillator();\
    const gain = ctx.createGain();\
    osc.type = 'sine';\
    osc.frequency.setValueAtTime(220, ctx.currentTime);\
    osc.frequency.exponentialRampToValueAtTime(660, ctx.currentTime + 0.3);\
    gain.gain.setValueAtTime(0, ctx.currentTime);\
    gain.gain.linearRampToValueAtTime(0.25, ctx.currentTime + 0.05);\
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);\
    osc.connect(gain).connect(sfxGain);\
    osc.start();\
    osc.stop(ctx.currentTime + 0.45);\
  \}\
\
  function playCorrect() \{\
    if (!sfxEnabled) return;\
    // Happy ascending arpeggio\
    [523.25, 659.25, 783.99, 1046.50].forEach((f, i) => \{\
      setTimeout(() => playTone(f, 0.25, 'triangle', 0.3), i * 90);\
    \});\
  \}\
\
  function playWrong() \{\
    if (!sfxEnabled) return;\
    // Descending buzz\
    playTone(196, 0.18, 'sawtooth', 0.25);\
    setTimeout(() => playTone(146.83, 0.35, 'sawtooth', 0.25), 180);\
  \}\
\
  function playDailyDouble() \{\
    if (!sfxEnabled) return;\
    ensureCtx();\
    // Fanfare\
    const notes = [\
      [392.00, 0.12], [523.25, 0.12], [659.25, 0.12],\
      [783.99, 0.4], [1046.50, 0.6]\
    ];\
    let t = 0;\
    notes.forEach(([f, d]) => \{\
      setTimeout(() => playTone(f, d, 'square', 0.22), t * 1000);\
      t += d;\
    \});\
  \}\
\
  function playTheme() \{\
    if (!sfxEnabled) return;\
    ensureCtx();\
    // Short Jeopardy-like theme sting\
    const melody = [\
      [523.25, 0.18], [659.25, 0.18], [783.99, 0.18],\
      [1046.50, 0.36], [783.99, 0.18], [1046.50, 0.54]\
    ];\
    let t = 0;\
    melody.forEach(([f, d]) => \{\
      setTimeout(() => playTone(f, d, 'triangle', 0.28), t * 1000);\
      t += d;\
    \});\
  \}\
\
  function playFinalJeopardyThink() \{\
    if (!sfxEnabled) return;\
    ensureCtx();\
    // Slow contemplative melody\
    const melody = [\
      [440, 0.5], [523.25, 0.5], [659.25, 0.5],\
      [587.33, 0.5], [523.25, 0.5], [440, 0.75],\
      [392, 0.5], [440, 0.5], [523.25, 1.0]\
    ];\
    let t = 0;\
    melody.forEach(([f, d]) => \{\
      setTimeout(() => playTone(f, d, 'sine', 0.25), t * 1000);\
      t += d;\
    \});\
  \}\
\
  // Background music \'97 simple looping game-show style groove\
  const bgMelody = [\
    // bar 1\
    [261.63, 0.25], [329.63, 0.25], [392.00, 0.25], [523.25, 0.25],\
    [392.00, 0.25], [523.25, 0.5], [0, 0.25],\
    // bar 2\
    [293.66, 0.25], [349.23, 0.25], [440.00, 0.25], [587.33, 0.25],\
    [440.00, 0.25], [587.33, 0.5], [0, 0.25],\
    // bar 3\
    [329.63, 0.25], [392.00, 0.25], [493.88, 0.25], [659.25, 0.25],\
    [493.88, 0.25], [659.25, 0.5], [0, 0.25],\
    // bar 4\
    [349.23, 0.25], [440.00, 0.25], [523.25, 0.25], [659.25, 0.25],\
    [523.25, 0.25], [783.99, 0.75]\
  ];\
\
  const bgBass = [\
    [130.81, 0.5], [0, 0.5], [130.81, 0.5], [0, 0.5],\
    [146.83, 0.5], [0, 0.5], [146.83, 0.5], [0, 0.5],\
    [164.81, 0.5], [0, 0.5], [164.81, 0.5], [0, 0.5],\
    [174.61, 0.5], [0, 0.5], [174.61, 0.5], [0, 0.5]\
  ];\
\
  function playMusicNote(freq, dur, vol=0.12, type='triangle') \{\
    if (freq === 0) return;\
    const osc = ctx.createOscillator();\
    const gain = ctx.createGain();\
    osc.type = type;\
    osc.frequency.setValueAtTime(freq, ctx.currentTime);\
    gain.gain.setValueAtTime(0, ctx.currentTime);\
    gain.gain.linearRampToValueAtTime(vol, ctx.currentTime + 0.02);\
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);\
    osc.connect(gain).connect(musicGain);\
    osc.start();\
    osc.stop(ctx.currentTime + dur + 0.05);\
  \}\
\
  function startBgMusic() \{\
    if (musicPlaying || !musicEnabled) return;\
    ensureCtx();\
    musicPlaying = true;\
    let nextTime = ctx.currentTime + 0.1;\
    const loopDur = 8; // seconds\
\
    function scheduleLoop() \{\
      if (!musicPlaying) return;\
      let t = 0;\
      bgMelody.forEach(([f, d]) => \{\
        const when = nextTime + t;\
        if (f > 0) \{\
          const osc = ctx.createOscillator();\
          const gain = ctx.createGain();\
          osc.type = 'triangle';\
          osc.frequency.setValueAtTime(f, when);\
          gain.gain.setValueAtTime(0, when);\
          gain.gain.linearRampToValueAtTime(0.10, when + 0.02);\
          gain.gain.exponentialRampToValueAtTime(0.001, when + d);\
          osc.connect(gain).connect(musicGain);\
          osc.start(when);\
          osc.stop(when + d + 0.05);\
        \}\
        t += d;\
      \});\
      // Bass\
      let bt = 0;\
      bgBass.forEach(([f, d]) => \{\
        const when = nextTime + bt;\
        if (f > 0) \{\
          const osc = ctx.createOscillator();\
          const gain = ctx.createGain();\
          osc.type = 'sine';\
          osc.frequency.setValueAtTime(f, when);\
          gain.gain.setValueAtTime(0, when);\
          gain.gain.linearRampToValueAtTime(0.18, when + 0.02);\
          gain.gain.exponentialRampToValueAtTime(0.001, when + d);\
          osc.connect(gain).connect(musicGain);\
          osc.start(when);\
          osc.stop(when + d + 0.05);\
        \}\
        bt += d;\
      \});\
      nextTime += loopDur;\
      musicTimer = setTimeout(scheduleLoop, (loopDur - 0.3) * 1000);\
    \}\
    scheduleLoop();\
  \}\
\
  function stopBgMusic() \{\
    musicPlaying = false;\
    if (musicTimer) \{ clearTimeout(musicTimer); musicTimer = null; \}\
  \}\
\
  function setMusicEnabled(on) \{\
    musicEnabled = on;\
    if (on) startBgMusic(); else stopBgMusic();\
  \}\
  function setSfxEnabled(on) \{ sfxEnabled = on; \}\
  function isMusicPlaying() \{ return musicPlaying; \}\
  function isMusicEnabled() \{ return musicEnabled; \}\
  function isSfxEnabled() \{ return sfxEnabled; \}\
\
  return \{\
    ensureCtx, playClick, playReveal, playCorrect, playWrong,\
    playDailyDouble, playTheme, playFinalJeopardyThink,\
    startBgMusic, stopBgMusic, setMusicEnabled, setSfxEnabled,\
    isMusicPlaying, isMusicEnabled, isSfxEnabled\
  \};\
\})();\
