function startGame() \{\
  // Reset scores & used clues\
  state.players.forEach(p => p.score = 0);\
  state.usedClues = \{\};\
  state.currentRound = 'jeopardy';\
  state.activeClue = null;\
  state.currentPlayer = 0;\
  state.fjWagers = \{\};\
  state.fjRevealed = \{\};\
  state.fjAnswerRevealed = false;\
  AudioEngine.ensureCtx();\
  AudioEngine.playTheme();\
  if (AudioEngine.isMusicEnabled()) AudioEngine.startBgMusic();\
  showScreen('game-screen');\
  renderGame();\
\}\
\
function renderGame() \{\
  $('#game-title-display').textContent = state.game.title;\
  const r = state.game.rounds[state.currentRound];\
  $('#game-round-label').textContent = r.name + ' Round';\
  $('#current-round-name').textContent = r.name;\
\
  // Scoreboard\
  const sb = $('#scoreboard');\
  sb.innerHTML = '';\
  state.players.forEach((p, i) => \{\
    const card = document.createElement('div');\
    card.className = 'player-card' + (i === state.currentPlayer ? ' active' : '');\
    card.innerHTML = `\
      <div class="player-color" style="background:$\{p.color\}"></div>\
      <div class="player-info">\
        <div class="player-name">$\{escapeHtml(p.name)\}</div>\
        <div class="player-score $\{p.score < 0 ? 'negative' : ''\}">$\{fmtMoney(p.score)\}</div>\
      </div>\
      <div class="score-controls">\
        <button class="score-btn plus" data-i="$\{i\}" data-amt="100" title="+100">+100</button>\
        <button class="score-btn minus" data-i="$\{i\}" data-amt="-100" title="-100">-100</button>\
      </div>\
    `;\
    card.addEventListener('click', (e) => \{\
      if (e.target.closest('.score-btn')) return;\
      state.currentPlayer = i;\
      AudioEngine.playClick();\
      renderGame();\
    \});\
    sb.appendChild(card);\
  \});\
  sb.querySelectorAll('.score-btn').forEach(btn => \{\
    btn.addEventListener('click', e => \{\
      e.stopPropagation();\
      const i = +btn.dataset.i;\
      const amt = +btn.dataset.amt;\
      state.players[i].score += amt;\
      AudioEngine.playClick();\
      saveState();\
      renderGame();\
    \});\
  \});\
\
  // Board\
  const board = $('#board');\
  board.innerHTML = '';\
  r.categories.forEach((cat, ci) => \{\
    const cell = document.createElement('div');\
    cell.className = 'board-cat';\
    cell.textContent = cat.name;\
    board.appendChild(cell);\
  \});\
  r.values.forEach((val, ri) => \{\
    r.categories.forEach((cat, ci) => \{\
      const clue = cat.clues[ri];\
      const used = state.usedClues[state.currentRound] && state.usedClues[state.currentRound].has(`$\{ci\}-$\{ri\}`);\
      const cell = document.createElement('div');\
      cell.className = 'clue' + (used ? ' used' : '');\
      cell.textContent = '$' + val;\
      if (!used) \{\
        cell.addEventListener('click', () => openClue(state.currentRound, ci, ri));\
      \}\
      board.appendChild(cell);\
    \});\
  \});\
\
  // Clues remaining\
  const usedSet = state.usedClues[state.currentRound] || new Set();\
  const remaining = (r.categories.length * r.values.length) - usedSet.size;\
  $('#clues-remaining').textContent = remaining;\
\}\
\
function openClue(round, catIndex, clueIndex) \{\
  const clue = state.game.rounds[round].categories[catIndex].clues[clueIndex];\
  if (!clue.question && !clue.answer) \{\
    toast('This clue is empty. Edit it first.');\
    return;\
  \}\
  if (clue.isDailyDouble) \{\
    showDailyDouble(round, catIndex, clueIndex, clue);\
    return;\
  \}\
  showClueModal(round, catIndex, clueIndex, clue, clue.value);\
\}\
\
function showDailyDouble(round, catIndex, clueIndex, clue) \{\
  state.activeClue = \{round, catIndex, clueIndex, clue, value: clue.value, isDailyDouble: true\};\
  AudioEngine.playDailyDouble();\
  const overlay = $('#dd-overlay');\
  overlay.classList.add('active');\
  // Populate player select\
  const sel = $('#dd-player-select');\
  sel.innerHTML = '';\
  state.players.forEach((p, i) => \{\
    const opt = document.createElement('option');\
    opt.value = i;\
    opt.textContent = p.name + ' (' + fmtMoney(p.score) + ')';\
    sel.appendChild(opt);\
  \});\
  sel.value = state.currentPlayer;\
  // Default wager: max of value or player's score\
  const player = state.players[state.currentPlayer];\
  const defaultWager = Math.max(clue.value, Math.max(player.score, 1000));\
  $('#dd-wager-input').value = defaultWager;\
  $('#dd-wager-input').min = 5;\
  $('#dd-player-name').textContent = state.players[state.currentPlayer].name + ' \'97 place your wager!';\
\}\
\
function showClueModal(round, catIndex, clueIndex, clue, value) \{\
  state.activeClue = \{round, catIndex, clueIndex, clue, value, isDailyDouble: false\};\
  AudioEngine.playReveal();\
  $('#qmodal-cat').textContent = state.game.rounds[round].categories[catIndex].name;\
  $('#qmodal-value').textContent = '$' + value;\
  $('#qmodal-text').textContent = clue.question;\
  $('#qmodal-answer').textContent = clue.answer || '\'97 no answer set \'97';\
  $('#qmodal-answer').classList.remove('show');\
  $('#qmodal-instruction').textContent = 'Click anywhere on the clue to reveal answer';\
  renderScoringRow();\
  $('#question-modal').classList.add('active');\
\}\
\
function renderScoringRow() \{\
  const row = $('#qmodal-scoring');\
  row.innerHTML = '';\
  state.players.forEach((p, i) => \{\
    const card = document.createElement('div');\
    card.className = 'score-card' + (i === state.currentPlayer ? ' active' : '');\
    const value = state.activeClue.isDailyDouble ? state.ddWager : state.activeClue.value;\
    card.innerHTML = `\
      <div class="sc-name"><span class="dot" style="background:$\{p.color\}"></span>$\{escapeHtml(p.name)\} \'97 $\{fmtMoney(p.score)\}</div>\
      <div class="sc-actions">\
        <button class="sc-btn pick" data-i="$\{i\}" title="Make active player">Pick</button>\
        <button class="sc-btn correct" data-i="$\{i\}" title="Correct (+$\{value\})">+$\{value\}</button>\
        <button class="sc-btn wrong" data-i="$\{i\}" title="Wrong (-$\{value\})">-$\{value\}</button>\
      </div>\
    `;\
    row.appendChild(card);\
  \});\
  row.querySelectorAll('.sc-btn.pick').forEach(b => b.addEventListener('click', () => \{\
    state.currentPlayer = +b.dataset.i;\
    AudioEngine.playClick();\
    renderScoringRow();\
  \}));\
  row.querySelectorAll('.sc-btn.correct').forEach(b => b.addEventListener('click', () => \{\
    const i = +b.dataset.i;\
    const value = state.activeClue.isDailyDouble ? state.ddWager : state.activeClue.value;\
    state.players[i].score += value;\
    state.currentPlayer = i;\
    AudioEngine.playCorrect();\
    saveState();\
    closeClueAndMarkUsed();\
  \}));\
  row.querySelectorAll('.sc-btn.wrong').forEach(b => b.addEventListener('click', () => \{\
    const i = +b.dataset.i;\
    const value = state.activeClue.isDailyDouble ? state.ddWager : state.activeClue.value;\
    state.players[i].score -= value;\
    AudioEngine.playWrong();\
    saveState();\
    renderScoringRow();\
    renderGame();\
  \}));\
\}\
\
function closeClueAndMarkUsed() \{\
  const \{round, catIndex, clueIndex\} = state.activeClue;\
  if (!state.usedClues[round]) state.usedClues[round] = new Set();\
  state.usedClues[round].add(`$\{catIndex\}-$\{clueIndex\}`);\
  state.activeClue = null;\
  $('#question-modal').classList.remove('active');\
  $('#dd-overlay').classList.remove('active');\
  renderGame();\
  // Check if round complete\
  const r = state.game.rounds[round];\
  const usedSet = state.usedClues[round];\
  if (usedSet.size === r.categories.length * r.values.length) \{\
    setTimeout(() => \{\
      if (round === 'jeopardy') showRoundTransition('DOUBLE JEOPARDY', () => \{\
        state.currentRound = 'doubleJeopardy';\
        renderGame();\
      \});\
      else if (round === 'doubleJeopardy') \{\
        showRoundTransition('FINAL JEOPARDY', () => startFinalJeopardy());\
      \}\
    \}, 600);\
  \}\
\}\
\
function showRoundTransition(title, cb) \{\
  $('#rt-title').textContent = title;\
  $('#round-transition').classList.add('active');\
  AudioEngine.playTheme();\
  setTimeout(() => \{\
    $('#round-transition').classList.remove('active');\
    cb();\
  \}, 2200);\
\}\
\
// ---------- FINAL JEOPARDY ----------\
function startFinalJeopardy() \{\
  state.currentRound = 'finalJeopardy';\
  state.fjWagers = \{\};\
  state.fjRevealed = \{\};\
  state.fjAnswerRevealed = false;\
  const fj = state.game.rounds.finalJeopardy;\
  if (!fj.question || !fj.answer) \{\
    toast('Final Jeopardy not configured. Edit it first.');\
    backToSetup();\
    return;\
  \}\
  $('#fj-cat').textContent = fj.category;\
  $('#fj-question').textContent = fj.question;\
  $('#fj-answer').textContent = fj.answer;\
  $('#fj-answer').classList.remove('show');\
  $('#fj-reveal-btn').style.display = 'inline-flex';\
  $('#fj-finalize-btn').style.display = 'none';\
  renderFjWagers();\
  $('#fj-screen').classList.add('active');\
  AudioEngine.playFinalJeopardyThink();\
\}\
\
function renderFjWagers() \{\
  const c = $('#fj-wagers');\
  c.innerHTML = '';\
  state.players.forEach((p, i) => \{\
    const card = document.createElement('div');\
    card.className = 'fj-wager-card';\
    const maxWager = Math.max(p.score, 1000);\
    const currentWager = state.fjWagers[i] || '';\
    const revealed = state.fjRevealed[i];\
    card.innerHTML = `\
      <div class="fwc-name"><span style="display:inline-block;width:12px;height:12px;background:$\{p.color\};border-radius:3px;margin-right:6px;"></span>$\{escapeHtml(p.name)\}</div>\
      <div class="fwc-score">$\{fmtMoney(p.score)\}</div>\
      <input type="number" class="fwc-input" data-i="$\{i\}" placeholder="Wager (max $\{maxWager\})" value="$\{currentWager\}" min="0" max="$\{Math.max(maxWager,0)\}" $\{p.score <= 0 ? 'disabled' : ''\} $\{revealed ? 'disabled' : ''\}>\
      <div class="fwc-actions">\
        <button class="fwc-btn correct" data-i="$\{i\}" $\{revealed ? 'disabled' : ''\}>Correct</button>\
        <button class="fwc-btn wrong" data-i="$\{i\}" $\{revealed ? 'disabled' : ''\}>Wrong</button>\
      </div>\
      $\{revealed ? `<div style="text-align:center;font-family:'Oswald';letter-spacing:1px;font-size:11px;color:$\{revealed === 'correct' ? 'var(--jep-green)' : '#ff6b6b'\};margin-top:8px;">$\{revealed.toUpperCase()\} ($\{fmtMoney(state.fjWagers[i] || 0)\})</div>` : ''\}\
    `;\
    c.appendChild(card);\
  \});\
  c.querySelectorAll('.fwc-input').forEach(inp => \{\
    inp.addEventListener('change', e => \{\
      const i = +e.target.dataset.i;\
      let v = parseInt(e.target.value) || 0;\
      const max = Math.max(state.players[i].score, 1000);\
      v = Math.min(Math.max(v, 0), max);\
      state.fjWagers[i] = v;\
      e.target.value = v;\
    \});\
  \});\
  c.querySelectorAll('.fwc-btn.correct').forEach(b => b.addEventListener('click', () => \{\
    const i = +b.dataset.i;\
    const w = state.fjWagers[i] || 0;\
    state.players[i].score += w;\
    state.fjRevealed[i] = 'correct';\
    AudioEngine.playCorrect();\
    saveState();\
    renderFjWagers();\
    renderGame();\
  \}));\
  c.querySelectorAll('.fwc-btn.wrong').forEach(b => b.addEventListener('click', () => \{\
    const i = +b.dataset.i;\
    const w = state.fjWagers[i] || 0;\
    state.players[i].score -= w;\
    state.fjRevealed[i] = 'wrong';\
    AudioEngine.playWrong();\
    saveState();\
    renderFjWagers();\
    renderGame();\
  \}));\
\}\
\
function showFjAnswer() \{\
  $('#fj-answer').classList.add('show');\
  state.fjAnswerRevealed = true;\
  $('#fj-reveal-btn').style.display = 'none';\
  $('#fj-finalize-btn').style.display = 'inline-flex';\
  AudioEngine.playReveal();\
\}\
\
function finalizeFj() \{\
  $('#fj-screen').classList.remove('active');\
  renderGame();\
  // Determine winner\
  const sorted = [...state.players].sort((a,b) => b.score - a.score);\
  const winner = sorted[0];\
  toast(`Winner: $\{winner.name\} with $\{fmtMoney(winner.score)\}!`, 5000);\
  AudioEngine.playTheme();\
\}\
\
function backToSetup() \{\
  AudioEngine.stopBgMusic();\
  showScreen('setup-screen');\
\}\
\
// ---------- EXPORT / IMPORT ----------\
function exportGame() \{\
  const data = JSON.stringify(\{\
    game: state.game,\
    players: state.players\
  \}, null, 2);\
  const blob = new Blob([data], \{type: 'application/json'\});\
  const url = URL.createObjectURL(blob);\
  const a = document.createElement('a');\
  a.href = url;\
  a.download = (state.game.title || 'jeopardy') + '.json';\
  a.click();\
  URL.revokeObjectURL(url);\
  toast('Exported game JSON');\
\}\
function importGame(file) \{\
  const reader = new FileReader();\
  reader.onload = e => \{\
    try \{\
      const data = JSON.parse(e.target.result);\
      if (data.game) state.game = data.game;\
      if (data.players) state.players = data.players;\
      saveState();\
      renderSetupPlayers();\
      $('#game-title-input').value = state.game.title;\
      toast('Game imported');\
    \} catch (err) \{\
      toast('Import failed \'97 invalid JSON');\
    \}\
  \};\
  reader.readAsText(file);\
\}\
\
// ---------- EVENT WIRING ----------\
function wireEvents() \{\
  // Setup\
  $('#add-player-btn').addEventListener('click', () => \{\
    if (state.players.length >= 6) \{ toast('Max 6 players'); return; \}\
    state.players.push(\{\
      name: `Player $\{state.players.length+1\}`,\
      color: PLAYER_COLORS[state.players.length % PLAYER_COLORS.length],\
      score: 0\
    \});\
    renderSetupPlayers();\
    saveState();\
  \});\
  $('#start-game-btn').addEventListener('click', () => \{\
    if (state.players.length < 2) \{ toast('Add at least 2 players'); return; \}\
    startGame();\
  \});\
  $('#open-editor-btn').addEventListener('click', () => \{\
    state.game.title = $('#game-title-input').value || 'Pharmacology Jeopardy';\
    saveState();\
    showScreen('editor-screen');\
    renderEditor();\
  \});\
  $('#game-title-input').addEventListener('input', e => \{\
    state.game.title = e.target.value;\
    saveState();\
  \});\
  $('#export-btn').addEventListener('click', exportGame);\
  $('#import-btn').addEventListener('click', () => $('#import-file').click());\
  $('#import-file').addEventListener('change', e => \{\
    if (e.target.files[0]) importGame(e.target.files[0]);\
    e.target.value = '';\
  \});\
  $('#load-sample-btn').addEventListener('click', () => \{\
    state.game = sampleGame();\
    saveState();\
    $('#game-title-input').value = state.game.title;\
    toast('Sample game loaded');\
  \});\
\
  // Audio settings\
  $('#sound-effects-check').addEventListener('change', e => \{\
    AudioEngine.setSfxEnabled(e.target.checked);\
  \});\
  $('#bg-music-check').addEventListener('change', e => \{\
    AudioEngine.setMusicEnabled(e.target.checked);\
    $('#music-toggle-btn').classList.toggle('active', e.target.checked);\
  \});\
\
  // Editor\
  $$('.editor-tab').forEach(t => t.addEventListener('click', () => \{\
    $$('.editor-tab').forEach(x => x.classList.remove('active'));\
    t.classList.add('active');\
    editorCurrentRound = t.dataset.round;\
    renderEditor();\
  \}));\
  $('#editor-back-btn').addEventListener('click', () => \{\
    saveState();\
    showScreen('setup-screen');\
  \});\
  $('#editor-play-btn').addEventListener('click', () => \{\
    saveState();\
    startGame();\
  \});\
  $('#fj-category-input').addEventListener('input', e => \{\
    state.game.rounds.finalJeopardy.category = e.target.value;\
    saveState();\
  \});\
  $('#fj-clue-input').addEventListener('input', e => \{\
    state.game.rounds.finalJeopardy.question = e.target.value;\
    saveState();\
  \});\
  $('#fj-answer-input').addEventListener('input', e => \{\
    state.game.rounds.finalJeopardy.answer = e.target.value;\
    saveState();\
  \});\
  $('#edit-save-btn').addEventListener('click', saveEditModal);\
  $('#edit-cancel-btn').addEventListener('click', cancelEditModal);\
  $('#edit-clear-btn').addEventListener('click', clearEditModal);\
  $('#edit-modal').addEventListener('click', e => \{\
    if (e.target.id === 'edit-modal') cancelEditModal();\
  \});\
\
  // Game header\
  $('#game-home-btn').addEventListener('click', backToSetup);\
  $('#fullscreen-btn').addEventListener('click', () => \{\
    if (!document.fullscreenElement) \{\
      document.documentElement.requestFullscreen?.();\
      $('#fullscreen-btn').innerHTML = '<i class="fa-solid fa-compress"></i>';\
    \} else \{\
      document.exitFullscreen?.();\
      $('#fullscreen-btn').innerHTML = '<i class="fa-solid fa-expand"></i>';\
    \}\
  \});\
  document.addEventListener('fullscreenchange', () => \{\
    $('#fullscreen-btn').innerHTML = document.fullscreenElement\
      ? '<i class="fa-solid fa-compress"></i>'\
      : '<i class="fa-solid fa-expand"></i>';\
  \});\
  $('#sound-toggle-btn').addEventListener('click', () => \{\
    const on = !AudioEngine.isSfxEnabled();\
    AudioEngine.setSfxEnabled(on);\
    $('#sound-toggle-btn').classList.toggle('active', on);\
    $('#sound-effects-check').checked = on;\
    if (on) AudioEngine.playClick();\
    toast('Sound effects ' + (on ? 'ON' : 'OFF'));\
  \});\
  $('#music-toggle-btn').addEventListener('click', () => \{\
    const on = !AudioEngine.isMusicEnabled();\
    AudioEngine.setMusicEnabled(on);\
    $('#music-toggle-btn').classList.toggle('active', on);\
    $('#bg-music-check').checked = on;\
    toast('Background music ' + (on ? 'ON' : 'OFF'));\
  \});\
  $('#prev-round-btn').addEventListener('click', () => \{\
    if (state.currentRound === 'doubleJeopardy') \{\
      state.currentRound = 'jeopardy';\
      renderGame();\
    \} else if (state.currentRound === 'finalJeopardy') \{\
      $('#fj-screen').classList.remove('active');\
      state.currentRound = 'doubleJeopardy';\
      renderGame();\
    \}\
  \});\
  $('#next-round-btn').addEventListener('click', () => \{\
    if (state.currentRound === 'jeopardy') \{\
      state.currentRound = 'doubleJeopardy';\
      renderGame();\
    \} else if (state.currentRound === 'doubleJeopardy') \{\
      startFinalJeopardy();\
    \}\
  \});\
  $('#reset-scores-btn').addEventListener('click', () => \{\
    if (!confirm('Reset all scores to $0?')) return;\
    state.players.forEach(p => p.score = 0);\
    state.usedClues = \{\};\
    state.currentRound = 'jeopardy';\
    saveState();\
    renderGame();\
    toast('Scores reset');\
  \});\
\
  // Question modal\
  $('#qmodal-close').addEventListener('click', () => \{\
    state.activeClue = null;\
    $('#question-modal').classList.remove('active');\
  \});\
  $('#qmodal-back').addEventListener('click', () => \{\
    state.activeClue = null;\
    $('#question-modal').classList.remove('active');\
  \});\
  $('#qmodal-reveal').addEventListener('click', revealAnswer);\
  $('#qmodal-text').addEventListener('click', revealAnswer);\
  function revealAnswer() \{\
    if (!$('#qmodal-answer').classList.contains('show')) \{\
      $('#qmodal-answer').classList.add('show');\
      $('#qmodal-instruction').textContent = 'Award points to a player, then close';\
      AudioEngine.playReveal();\
    \}\
  \}\
\
  // Daily Double\
  $('#dd-confirm').addEventListener('click', () => \{\
    const playerIdx = +$('#dd-player-select').value;\
    const wager = parseInt($('#dd-wager-input').value) || 0;\
    const player = state.players[playerIdx];\
    const maxWager = Math.max(player.score, 1000);\
    if (wager < 5) \{ toast('Wager must be at least $5'); return; \}\
    if (wager > maxWager) \{ toast(`Max wager is $\{fmtMoney(maxWager)\}`); return; \}\
    state.currentPlayer = playerIdx;\
    state.ddWager = wager;\
    $('#dd-overlay').classList.remove('active');\
    const ac = state.activeClue;\
    showClueModal(ac.round, ac.catIndex, ac.clueIndex, ac.clue, wager);\
  \});\
  $('#dd-player-select').addEventListener('change', e => \{\
    const idx = +e.target.value;\
    state.currentPlayer = idx;\
    const player = state.players[idx];\
    const ac = state.activeClue;\
    const defaultWager = Math.max(ac.clue.value, Math.max(player.score, 1000));\
    $('#dd-wager-input').value = defaultWager;\
    $('#dd-player-name').textContent = player.name + ' \'97 place your wager!';\
  \});\
\
  // Final Jeopardy\
  $('#fj-reveal-btn').addEventListener('click', showFjAnswer);\
  $('#fj-finalize-btn').addEventListener('click', finalizeFj);\
  $('#fj-back-btn').addEventListener('click', () => \{\
    $('#fj-screen').classList.remove('active');\
    state.currentRound = 'doubleJeopardy';\
    renderGame();\
  \});\
\
  // Keyboard shortcuts\
  document.addEventListener('keydown', e => \{\
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;\
    if ($('#question-modal').classList.contains('active')) \{\
      if (e.key === 'Escape') \{\
        state.activeClue = null;\
        $('#question-modal').classList.remove('active');\
      \} else if (e.key === ' ' || e.key === 'Enter') \{\
        e.preventDefault();\
        revealAnswer();\
      \}\
    \} else if ($('#dd-overlay').classList.contains('active')) \{\
      if (e.key === 'Enter') $('#dd-confirm').click();\
    \} else if ($('#game-screen').classList.contains('active')) \{\
      if (e.key === 'f' || e.key === 'F') $('#fullscreen-btn').click();\
    \}\
  \});\
\}\
\
// ---------- INIT ----------\
function init() \{\
  loadState();\
  renderSetupPlayers();\
  populateSavedGames();\
  $('#game-title-input').value = state.game.title;\
  wireEvents();\
  // Set initial audio toggle states\
  $('#sound-toggle-btn').classList.toggle('active', AudioEngine.isSfxEnabled());\
\}\
\
init();\
</script>\
</body>\
</html>}