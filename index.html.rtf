      <button class="remove-btn" data-i="$\{i\}" title="Remove player"><i class="fa-solid fa-xmark"></i></button>\
    `;\
    container.appendChild(row);\
  \});\
  container.querySelectorAll('input[type="color"]').forEach(el => \{\
    el.addEventListener('input', e => \{\
      const i = +e.target.dataset.i;\
      state.players[i].color = e.target.value;\
      e.target.parentElement.style.background = e.target.value;\
      saveState();\
    \});\
  \});\
  container.querySelectorAll('input[type="text"]').forEach(el => \{\
    el.addEventListener('input', e => \{\
      const i = +e.target.dataset.i;\
      state.players[i].name = e.target.value || `Player $\{i+1\}`;\
