      const cell = document.createElement('div');\
      cell.className = 'editor-cell';\
      let html = `<div>$$\{val\}</div>`;\
      if (clue.question) \{\
        html += `<div class="clue-preview">$\{escapeHtml(clue.question.slice(0, 60))\}$\{clue.question.length > 60 ? '\'85' : ''\}</div>`;\
        html += `<div class="clue-preview" style="color:var(--jep-gold); opacity:0.7">A: $\{escapeHtml(clue.answer.slice(0, 40))\}$\{clue.answer.length > 40 ? '\'85' : ''\}</div>`;\
      \} else \{\
        html += `<div class="cat-name">Empty \'97 click to edit</div>`;\
      \}\
      if (clue.isDailyDouble) html += `<div class="dd-badge">DD</div>`;\
      cell.innerHTML = html;\
      cell.addEventListener('click', () => openEditClue(editorCurrentRound, ci, ri));\
      board.appendChild(cell);\
    \});\
  \});\
\
  container.appendChild(board);\
